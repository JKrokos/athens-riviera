# Postgres connection string. On Railway this is provided as a reference to
# the Postgres service. DATABASE_PUBLIC_URL is used automatically during
# `next build` because Railway's private network is runtime-only.
DATABASE_URL=postgres://postgres@localhost:5432/athensriviera
DATABASE_PUBLIC_URL=

# Payload
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Railway S3 bucket for media uploads. Leave empty in local dev to store
# uploads on the local filesystem (./media).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Secrets for maintenance endpoints
REVALIDATE_SECRET=change-me
IMPORT_SECRET=change-me

# Optional: create the first admin user on boot when none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: run the WordPress import on boot when the database is empty
# ("true" imports when empty, "force" always re-imports)
IMPORT_ON_BOOT=

# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Admin "Preview" button → /api/preview (Next.js draft mode: renders the page
# fresh and shows unpublished listings). Falls back to REVALIDATE_SECRET;
# leave draft mode via /api/preview?exit=1&path=/
PREVIEW_SECRET=change-me
